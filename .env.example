# Public browser configuration. Never put a service-role key in VITE_*.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Backend scripts only. Keep in .env.local; never commit.
SUPABASE_SERVICE_ROLE_KEY=
# Optional local test/demo user; no default password is shipped.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# Separate central-panel deployment: panel. Clinic deployment: clinic.
VITE_APP_MODE=clinic
# Public website origin; useful when exporting a clinic connection.
VITE_SITE_URL=
